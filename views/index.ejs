<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Online Clipboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md bg-white p-6 rounded-lg shadow-md">
      <h1 class="text-2xl font-bold text-center text-blue-600">
        Online Clipboard
      </h1>

      <!-- Display Message (Success or Error) -->
      <% if (message) { %>
      <p
        class="<%= messageType === 'success' ? 'text-green-600' : 'text-red-600' %> font-semibold text-center my-2"
      >
        <%= message %>
      </p>
      <% } %>

      <!-- Form to Save Text -->
      <form id="saveForm" action="/save" method="POST" class="mt-4">
        <!-- Save Text Form -->
        <textarea
          name="text"
          class="w-full p-3 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400 h-40"
          placeholder="Paste your text here..."
          required
        ></textarea>

        <button
          type="submit"
          class="w-full mt-3 bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600 transition flex justify-center items-center"
        >
          Generate Code
          <span
            id="saveLoader"
            class="hidden ml-2 h-5 w-5 border-2 border-white border-t-transparent rounded-full animate-spin"
          ></span>
        </button>
      </form>

      <hr class="my-4" />

      <!-- Retrieve Section -->
      <h2 class="text-lg font-semibold text-gray-700 text-center">
        Retrieve Data
      </h2>
      <% if (retrievedText) { %>
      <p class="mt-2 text-gray-700 font-medium">Retrieved Data:</p>
      <textarea
        id="retrievedText"
        class="w-full p-3 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400 h-40"
        readonly
      >
<%= retrievedText %></textarea
      >

      <button
        onclick="copyToClipboard()"
        class="w-full mt-2 bg-green-500 text-white py-2 rounded-md hover:bg-green-600 transition"
      >
        Copy to Clipboard
      </button>
      <p id="copyMessage" class="text-green-600 text-center mt-2 hidden">
        Copied!
      </p>
      <% } %>

      <!-- Form to Retrieve Text -->
      <form id="retrieveForm" action="/retrieve" method="POST" class="mt-4">
        <input
          type="text"
          name="code"
          class="w-full p-3 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400"
          placeholder="Enter 4-digit code"
          required
        />
        <button
          type="submit"
          class="w-full mt-3 bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600 transition flex justify-center items-center"
        >
          Retrieve
          <span
            id="retrieveLoader"
            class="hidden ml-2 h-5 w-5 border-2 border-white border-t-transparent rounded-full animate-spin"
          ></span>
        </button>
      </form>
    </div>

    <script>
      function copyToClipboard() {
        const textArea = document.getElementById("retrievedText");
        textArea.select();
        document.execCommand("copy");

        document.getElementById("copyMessage").classList.remove("hidden");
        setTimeout(() => {
          document.getElementById("copyMessage").classList.add("hidden");
        }, 3000);
      }

      document
        .getElementById("saveForm")
        .addEventListener("submit", function () {
          document.getElementById("saveLoader").classList.remove("hidden");
        });

      document
        .getElementById("retrieveForm")
        .addEventListener("submit", function () {
          document.getElementById("retrieveLoader").classList.remove("hidden");
        });
    </script>
  </body>
</html>
