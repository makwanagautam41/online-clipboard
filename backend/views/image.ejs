<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Online Clipboard - Images</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-gray-900 flex flex-col items-center justify-center text-white"
  >
    <!-- Navbar -->
    <nav
      class="w-full bg-gray-800 p-4 flex justify-between items-center shadow-md"
    >
      <h1 class="text-white text-xl font-bold">Clipboard</h1>
      <div class="flex items-center gap-4">
        <a href="/" class="text-white hover:underline">Text</a>
        <a href="/image" class="text-blue-400 hover:underline">Image</a>
      </div>
    </nav>

    <div class="w-full max-w-md bg-gray-800 p-6 rounded-lg shadow-md mt-6">
      <h1 class="text-2xl font-bold text-center text-blue-400">
        Image Clipboard
      </h1>

      <!-- Display Message (Success or Error) -->
      <% if (message) { %>
      <p
        class="<%= messageType === 'success' ? 'text-green-400' : 'text-red-400' %> font-semibold text-center my-2"
      >
        <%= message %>
      </p>
      <% } %>

      <!-- Form to Upload Image -->
      <form
        id="uploadForm"
        action="/upload-image"
        method="POST"
        enctype="multipart/form-data"
        class="mt-4"
      >
        <input
          type="file"
          name="image"
          accept="image/*"
          required
          class="w-full p-2 border rounded-md bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-400"
        />

        <button
          type="submit"
          class="w-full mt-3 bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600 transition flex justify-center items-center"
        >
          Upload Image
          <span
            id="uploadLoader"
            class="hidden ml-2 h-5 w-5 border-2 border-white border-t-transparent rounded-full animate-spin"
          ></span>
        </button>
      </form>

      <hr class="my-4 border-gray-600" />

      <!-- Retrieve Section -->
      <h2 class="text-lg font-semibold text-white text-center">
        Retrieve Image
      </h2>

      <!-- Show Retrieved Image -->
      <% if (retrievedImage) { %>
      <p class="mt-2 text-white font-medium">Retrieved Image:</p>
      <div class="flex flex-col items-center">
        <img
          src="<%= retrievedImage.imageUrl %>"
          alt="Retrieved Image"
          class="w-48 h-auto mt-2 rounded-md shadow-lg border border-gray-600"
        />

        <!-- Download Button -->
        <a
          href="<%= retrievedImage.imageUrl %>"
          download="Clipboard-Image"
          class="mt-3 bg-green-500 text-white py-2 px-4 rounded-md hover:bg-green-600 transition flex items-center"
        >
          Download Image
        </a>
      </div>
      <% } %>

      <!-- Form to Retrieve Image -->
      <form
        id="retrieveForm"
        action="/retrieve-image"
        method="POST"
        class="mt-4"
      >
        <input
          type="text"
          name="code"
          class="w-full p-3 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400 bg-gray-700 text-white"
          placeholder="Enter 4-digit code"
          required
        />

        <button
          type="submit"
          class="w-full mt-3 bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600 transition flex justify-center items-center"
        >
          Retrieve Image
          <span
            id="retrieveLoader"
            class="hidden ml-2 h-5 w-5 border-2 border-white border-t-transparent rounded-full animate-spin"
          ></span>
        </button>
      </form>
    </div>

    <script>
      document
        .getElementById("uploadForm")
        .addEventListener("submit", function () {
          document.getElementById("uploadLoader").classList.remove("hidden");
        });

      document
        .getElementById("retrieveForm")
        .addEventListener("submit", function () {
          document.getElementById("retrieveLoader").classList.remove("hidden");
        });
    </script>
  </body>
</html>
